# Supabase Configuration (Local Development)
MY_SUPABASE_URL="http://kong:8000"
MY_SUPABASE_ANON_KEY="your-anon-key"
MY_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
MY_SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Orange PG (ICICI Bank Payment Gateway)
# For production, replace with production credentials from ICICI
ORANGE_PG_MERCHANT_ID="your-merchant-id"
ORANGE_PG_AGGREGATOR_ID="your-aggregator-id"
ORANGE_PG_SECRET_KEY="your-secret-key"
# UAT URL - for production use: https://pgpay.icicibank.com/tsp/pg/api/v2/initiateSale
ORANGE_PG_INITIATE_SALE_URL="https://pgpayuat.icicibank.com/tsp/pg/api/v2/initiateSale"
# UAT URL - for production use: https://pgpay.icicibank.com/tsp/pg/api/command
ORANGE_PG_STATUS_CHECK_URL="https://pgpayuat.icicibank.com/tsp/pg/api/command"
ORANGE_PG_REFUND_URL="https://pgpayuat.icicibank.com/tsp/pg/api/command"

# Razorpay Payment Gateway
# Get your keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_live_XXXXXXXX"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# Payment URLs (approved by bank)
# Local development URLs
PAYMENT_RETURN_URL="http://localhost:54321/functions/v1/payment-callback"
PAYMENT_SUCCESS_URL="http://localhost:5173/payment/success"
PAYMENT_FAILURE_URL="http://localhost:5173/payment/failure"
HOST_URL="http://localhost:5173"

# Other Services
CAL_API_KEY="your-cal-api-key"
HELTAR_API_KEY="your-heltar-api-key"

# Cratio CRM (lead lookup for the Instructor Management slot-booking workflow)
# CRATIO_LEAD_LOOKUP_URL: the Cratio apirequest.php endpoint the instructor-slot-booking edge
#   function searches by customer e-mail (or Lead ID once Cratio exposes it). Never expose this, or the token, to the
#   browser.
# CRATIO_API_TOKEN: the Cratio API token (server-side only).
CRATIO_LEAD_LOOKUP_URL="https://apps.cratiocrm.com/..."
CRATIO_API_TOKEN="your-cratio-api-token"

# Email Configuration
SMTP_PASSWORD="your-smtp-password"
SMTP_USERNAME="your-smtp-username"
SMTP_FROM="your-from-email"
ADMIN_EMAIL="admin@example.com"
